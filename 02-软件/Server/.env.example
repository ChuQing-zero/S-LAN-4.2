# ========== S-LAN Server 配置模板 ==========
# 复制本文件为 .env 并填入真实值

# 服务器端口 (V1.2 开发版用 3002，V1.1 正式版用 3001)
SERVER_PORT=4002

# JWT 签名密钥（改成你自己的随机字符串）
JWT_SECRET=change-me-to-random-string

# MongoDB 连接地址
MONGODB_URI=mongodb://127.0.0.1:28018/s-lan-local

# ========== 火山引擎 OCR（可选，不配也能用本地 OCR）==========
VOLC_ACCESSKEY=
VOLC_SECRETKEY=

# ========== ARK 大模型（可选）==========
ARK_API_KEY=
ARK_MODEL=

# ========== DeepSeek（可选）==========
DEEPSEEK_API_KEY=

# ========== 卡图目录 ==========
TCG_DATABASE_PATH=D:\Project\S-LAN\Code\V1.1\Storage\tcg-data

# ========== 卡牌目录本地 JSON 路径 ==========
CARD_CATALOG_PATH=../Storage/card-catalog

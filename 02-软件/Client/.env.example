# 复制此文件为 .env 并填入真实值

# 前端开发服务器端口
VITE_DEV_PORT=5173

# 后端 API 端口 (Server .env SERVER_PORT=3002)
VITE_API_PORT=3002
VITE_API_PREFIX=/v1/api
# H5 生产: /v1/api (同源) | APP/小程序: 完整地址如 http://192.168.1.100:3002/v1/api
VITE_API_BASE_URL=/v1/api
VITE_API_TOKEN=test

# 本地模式：true = 仅对接本地后端
VITE_USE_LOCAL=true

# WebSocket 地址 (APP/小程序需要): ws://192.168.1.100:3002/ws
VITE_WS_URL=
